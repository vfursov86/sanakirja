@page
@model VerbiRektioModel
@{
    ViewData["Title"] = "Rektio";
}
<h1>@ViewData["Title"]</h1>

<!-- items being paged -->
<table class="table">
    <tbody>
        @foreach (KeyValuePair<string, string> kvp in Model.Items)
        {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => kvp.Key)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => kvp.Value)
                </td>
            </tr>
        }
    </tbody>
</table>

<!-- pager -->
@if (Model.Pager.Pages.Any())
{
    <nav class="table-responsive">
        <ul class="pagination justify-content-center d-flex flex-wrap">
            @if (Model.Pager.CurrentPage > 1)
            {
                <li class="page-item">
                    <a class="page-link" href="/VerbiRektio?p=1">Ensimmäinen</a>
                </li>
                <li class="page-item">
                    <a class="page-link" href="/VerbiRektio?p=@(Model.Pager.CurrentPage - 1)">Edellinen</a>
                </li>
            }
            @foreach (var p in Model.Pager.Pages)
            {
                <li class="page-item @(p == Model.Pager.CurrentPage ? "active" : "")">
                    <a class="page-link" href="/VerbiRektio?p=@p">@p</a>
                </li>
            }
            @if (Model.Pager.CurrentPage < Model.Pager.TotalPages)
            {
                <li class="page-item">
                    <a class="page-link" href="/VerbiRektio?p=@(Model.Pager.CurrentPage + 1)">Seuraava</a>
                </li>
                <li class="page-item">
                    <a class="page-link" href="/VerbiRektio?p=@Model.Pager.TotalPages">Viimeinen</a>
                </li>
            }
        </ul>
    </nav>
}

<!-- Mnemonic Groups -->
<div class="row mt-4">
    <!-- Finnish mnemonics -->
    <div class="col-md-6">
        <h3>Muistisäännöt</h3>
        <ul>
            <li><strong>Viestintäverbit (sta/stä)</strong> – puhua, kirjoittaa, kertoa → aiheesta</li>
            <li><strong>Tunteet ja asenteet (P)</strong> – rakastaa, vihata, pelätä → tunne on “osittainen”</li>
            <li><strong>Liike kohti (Mihin / Ill / All)</strong> – mennä, soittaa → mihin</li>
            <li><strong>Liike pois (Mistä)</strong> – tulla, erota → mistä</li>
            <li><strong>Välineet (lla/llä)</strong> – maksaa, leikata → millä</li>
            <li><strong>Omistus / tarve (Genetiivi)</strong> – tarvita, haluta → kenen</li>
            <li><strong>Kaksoisrektiot (P + Mihin)</strong> – auttaa jotakuta pääsemään johonkin</li>
            <li><strong>Idiomaattiset rektiot (sta/stä)</strong> – pitää jostakin</li>
            <li><strong>Tilasiirtymä (Mihin)</strong> – päästä, ehtiä, jäädä → uuteen tilaan</li>
            <li><strong>Keskeneräinen toiminta (P)</strong> – etsiä jotakin</li>
            <li><strong>Valmis toiminta (Akkusatiivi)</strong> – löytää jonkin</li>
            <li><strong>Toiminnan aloitus (maan/mään)</strong> – mennä nukkumaan, joutua tekemään, pystyä tekemään</li>
        </ul>
    </div>

    <!-- Russian mnemonics -->
    <div class="col-md-6">
        <h3>Мнемоника</h3>
        <ul>
            <li><strong>Коммуникация (sta/stä)</strong> – говорить, писать, рассказывать “о чём‑то”</li>
            <li><strong>Эмоции и отношения (P)</strong> – любить, ненавидеть, бояться → чувство неполное</li>
            <li><strong>Движение к цели (Mihin / Ill / All)</strong> – идти, звонить → “куда”</li>
            <li><strong>Движение от источника (Mistä)</strong> – прийти, отделиться → “откуда”</li>
            <li><strong>Инструмент, транспорт (lla/llä)</strong> – платить, резать, ехать → “чем”, "на чём"</li>
            <li><strong>Обладание / необходимость (Genetiivi)</strong> – нуждаться, хотеть → “кого/чего”</li>
            <li><strong>Двойное управление (P + Mihin)</strong> – помочь кому‑то попасть куда‑то</li>
            <li><strong>Идиоматические управления (sta/stä)</strong> – “нравится что‑то”</li>
            <li><strong>Переход в новое состояние (Mihin)</strong> – попасть, успеть, остаться → “куда” (в состояние)</li>
            <li><strong>Незавершённое действие (P)</strong> – искать → искать что‑то</li>
            <li><strong>Завершённое действие (Akkusatiivi)</strong> – найти → найти что‑то</li>
            <li><strong>Переход к действию (maan/mään)</strong> – начать делать, быть вынужденным делать, иметь возможность делать</li>
        </ul>
    </div>
</div>

